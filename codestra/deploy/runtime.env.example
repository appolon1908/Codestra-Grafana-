# Non-secret Codestra Grafana deployment contract.
# Secret values are supplied as external runtime secret files and never belong here.

CODESTRA_ENVIRONMENT=staging
CODESTRA_REGION=hetzner-eu
CODESTRA_DEPLOYMENT_ID=replace-with-immutable-release-id

# Deployment is digest-only and never builds on the target host.
CODESTRA_GRAFANA_IMAGE=ghcr.io/appolon1908-hue/codestra-grafana--grafana@sha256:REPLACE_WITH_64_LOWERCASE_HEX
CODESTRA_SOURCE_SHA=REPLACE_WITH_40_LOWERCASE_HEX
CODESTRA_IMAGE_DIGEST=sha256:REPLACE_WITH_64_LOWERCASE_HEX

GRAFANA_HOST_PORT=3000
GF_DATABASE_HOST=postgres-grafana:5432
GF_DATABASE_NAME=grafana

CODESTRA_OBSERVABILITY_NETWORK=codestra-observability
CODESTRA_DATABASE_NETWORK=codestra-database

# File paths only. Values are created by the approved secrets authority and never enter Compose.
GRAFANA_OIDC_CLIENT_SECRET_FILE=/run/secrets/codestra/grafana/oidc-client-secret
GRAFANA_DATABASE_USER_FILE=/run/secrets/codestra/grafana/database-user
GRAFANA_DATABASE_PASSWORD_FILE=/run/secrets/codestra/grafana/database-password
GRAFANA_DATABASE_CA_FILE=/run/secrets/codestra/grafana/database-ca.pem
GRAFANA_SECRET_KEY_FILE=/run/secrets/codestra/grafana/secret-key
