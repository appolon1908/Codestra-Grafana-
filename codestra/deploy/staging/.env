# Validation-only fail-closed defaults.
#
# Docker Compose loads this file only when rendering the staging model during
# source validation. The reserved .invalid URL, impossible source SHA, and
# non-secret sentinel file cannot represent an approved deployment. Protected
# staging must override every value with reviewed runtime inputs.
GRAFANA_ROOT_URL=https://grafana.validation.invalid/
GRAFANA_SOURCE_SHA=0000000000000000000000000000000000000000
GRAFANA_ADMIN_PASSWORD_FILE=./validation/empty-secret
GRAFANA_SECRET_KEY_FILE=./validation/empty-secret
