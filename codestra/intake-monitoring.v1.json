{
  "schemaVersion": "1.0",
  "status": "CONTRACT_PREPARED_NOT_DEPLOYED",
  "domain": "unified-intake",
  "canonicalFlow": [
    "website-or-widget",
    "@codestra/intake-form-or-intake-survey",
    "@codestra/intake-sdk",
    "same-origin-intake-bff",
    "caddy",
    "kong",
    "middleware-durable-intake",
    "odoo-or-analytics-or-approved-workflow"
  ],
  "events": [
    "codestra.events.lead_submitted",
    "codestra.events.survey_response_submitted"
  ],
  "safeDimensions": [
    "codestra_business",
    "application",
    "service",
    "environment",
    "server",
    "region",
    "deployment",
    "channel",
    "form_kind",
    "survey_kind",
    "result",
    "reason",
    "delivery_target",
    "anonymous"
  ],
  "forbiddenLabelsOrPayloads": [
    "tenant_id",
    "site_id",
    "campaign_id",
    "form_id",
    "survey_id",
    "question_id",
    "customer_id",
    "contact_id",
    "lead_id",
    "response_id",
    "account_id",
    "user_id",
    "email",
    "phone",
    "name",
    "address",
    "message",
    "transcript",
    "answers",
    "custom_fields",
    "consent_text",
    "request_id",
    "correlation_id",
    "trace_id",
    "span_id",
    "idempotency_key",
    "raw_url",
    "query_string",
    "referrer",
    "landing_page",
    "utm_source",
    "utm_medium",
    "utm_campaign",
    "utm_term",
    "utm_content"
  ],
  "privacyRules": {
    "rawFormAnswersInTelemetry": false,
    "rawSurveyAnswersInTelemetry": false,
    "contactDataInMetricLabels": false,
    "customerOrPersonDataInLogLabels": false,
    "anonymousSurveyMayCarryContactOrLeadId": false,
    "browserReceivesObservabilityCredentials": false
  },
  "activation": {
    "runtimeApplied": false,
    "productionTargetsEnabled": false,
    "liveBusinessWritesEnabledByThisContract": false
  },
  "component": "grafana",
  "responsibility": "read-only intake forms and surveys operational dashboard",
  "features": {
    "dashboardUid": "codestra-intake-operations",
    "datasources": [
      "codestra-prometheus",
      "codestra-loki",
      "codestra-tempo"
    ],
    "mutationAuthority": false,
    "customerDrilldown": false
  }
}
